# Local development host ports
PUBLIC_HTTP_PORT=10100
INTERNAL_HTTP_PORT=10101
GRPC_PORT=10102
POSTGRES_PORT=10112

POSTGRES_USER=usermgmt
POSTGRES_PASSWORD=usermgmt
POSTGRES_DB=usermgmt

# Used when running the Go binary on the host
PUBLIC_HTTP_ADDR=:10100
INTERNAL_HTTP_ADDR=:10101
GRPC_ADDR=:10102
DATABASE_URL=postgres://usermgmt:usermgmt@localhost:10112/usermgmt?sslmode=disable

# So `docker compose up -d` from the repo root uses the local-dev stack
COMPOSE_FILE=dev-docker/docker-compose.yml
